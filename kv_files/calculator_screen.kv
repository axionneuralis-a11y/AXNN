#:import dp kivy.metrics.dp

<CalculatorScreen>:
    MDBoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(12)

        MDLabel:
            id: calc_display
            text: "0"
            halign: "right"
            font_style: "H3"
            size_hint_y: 0.3

        MDGridLayout:
            cols: 4
            spacing: dp(8)

            MDRaisedButton:
                text: "7"
                on_release: root.press_key("7")
            MDRaisedButton:
                text: "8"
                on_release: root.press_key("8")
            MDRaisedButton:
                text: "9"
                on_release: root.press_key("9")
            MDRaisedButton:
                text: "÷"
                on_release: root.press_key("÷")

            MDRaisedButton:
                text: "4"
                on_release: root.press_key("4")
            MDRaisedButton:
                text: "5"
                on_release: root.press_key("5")
            MDRaisedButton:
                text: "6"
                on_release: root.press_key("6")
            MDRaisedButton:
                text: "×"
                on_release: root.press_key("×")

            MDRaisedButton:
                text: "1"
                on_release: root.press_key("1")
            MDRaisedButton:
                text: "2"
                on_release: root.press_key("2")
            MDRaisedButton:
                text: "3"
                on_release: root.press_key("3")
            MDRaisedButton:
                text: "-"
                on_release: root.press_key("-")

            MDRaisedButton:
                text: "C"
                on_release: root.clear()
            MDRaisedButton:
                text: "0"
                on_release: root.press_key("0")
            MDRaisedButton:
                text: "="
                on_release: root.calculate()
            MDRaisedButton:
                text: "+"
                on_release: root.press_key("+")

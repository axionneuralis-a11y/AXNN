#:import dp kivy.metrics.dp

<CalendarScreen>:
    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            title: "Kalender"

        MDBoxLayout:
            orientation: "horizontal"
            padding: dp(12)
            size_hint_y: None
            height: dp(56)

            MDIconButton:
                icon: "chevron-left"
                on_release: root.prev_month()

            MDLabel:
                id: month_label
                text: ""
                halign: "center"
                font_style: "H6"

            MDIconButton:
                icon: "chevron-right"
                on_release: root.next_month()

        ScrollView:
            MDBoxLayout:
                id: day_detail_container
                orientation: "vertical"
                padding: dp(16)
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height

#:import dp kivy.metrics.dp

<EditorScreen>:
    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            title: "AXNN Editor"
            left_action_items: [["arrow-left", lambda x: app.go_back()]]
            right_action_items: [["content-save", lambda x: app.save_editor()]]

        BasicCodeEditor:
            id: code_input 

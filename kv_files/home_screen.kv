<HomeScreen>:
    BoxLayout:
        orientation: 'vertical'
        MDToolbar:
            title: "AXNN"
            right_action_items: [['console', lambda x: root.open_editor()]]
        ScrollView:
            MDList:
                MDLabel:
                    text: "Catatan Terbaru"
                    font_style: "H6"
                # Render recent_notes via RecycleView (M2)
        # Banner AXION Neuralis (F016) — posisi bawah Home
        MDCard:
            orientation: 'vertical'
            MDLabel:
                text: "AXION Neuralis"
                halign: 'center' 

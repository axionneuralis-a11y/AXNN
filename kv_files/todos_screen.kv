<<TodosScreen>:
    MDBoxLayout:
        orientation: 'vertical'
        
        MDToolbar:
            title: "Daftar Tugas"
            right_action_items: [['plus', lambda x: root.show_add_dialog()]]
            
        ScrollView:
            MDBoxLayout:
                id: todo_container
                orientation: 'vertical'
                padding: dp(16)
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height
